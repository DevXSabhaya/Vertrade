NODE_ENV=
PORT=3000
MONGODB_URI=

# Angel One SmartAPI credentials — never commit real values. Only required
# when TRADING_MODE=LIVE below; a Paper-only deployment boots fine with all
# of these left blank.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
# Base32 TOTP secret issued by Angel One when enabling 2FA on the account.
ANGEL_ONE_TOTP_SECRET=
# Reserved for future Angel One request-signing/checksum support.
ANGEL_ONE_API_SECRET=
# Passphrase used to derive the AES-256-GCM key that encrypts broker tokens at rest.
TOKEN_ENCRYPTION_KEY=

# MOCK (default) simulates ticks in-memory, no broker connection required.
# ANGEL_ONE streams real market data via the Angel One WebSocket feed.
MARKET_DATA_PROVIDER=MOCK

# MOCK (default) serves a seeded set of equities + index options (SENSEX,
# NIFTY, BANKNIFTY, CRUDEOIL) entirely in-memory, no broker connection
# required — this is what lets Paper trading resolve natural trading calls
# like "SENSEX 77200 CE" locally. ANGEL_ONE downloads the real instrument
# master feed and requires TRADING_MODE=LIVE credentials above.
INSTRUMENT_MASTER_PROVIDER=MOCK

# PAPER (default) uses the PaperExecutor (simulated fills, generous risk
# limits, no broker credentials required). LIVE uses the real AngelOneExecutor
# and conservative risk limits, and requires every ANGEL_ONE_* credential
# above plus the TRADING_ENABLED feature flag — the app refuses to boot in
# LIVE mode if broker credentials are missing, and never silently falls back
# to PAPER.
TRADING_MODE=PAPER
# When true, the Order Queue rejects every new trade (existing trades continue).
KILL_SWITCH_ENABLED=false

# Broker Health Monitor / Scheduler configuration.
HEALTH_CHECK_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=15000
# When true, overall health always reports MAINTENANCE and automatic recovery is skipped.
MAINTENANCE_MODE=false
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# Phase 12: product API authentication + paper trading account defaults.
# Secret used to sign/verify user JWT access tokens — never commit a real value.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Starting virtual balance for a newly-created paper trading account.
PAPER_TRADING_INITIAL_BALANCE=100000

# Phase 13: explicitly-trusted CORS origin(s), comma-separated for more than
# one (e.g. FRONTEND_URL=https://app.example.com,https://staging.example.com
# in production). In development, any http(s)://localhost:<port> or
# 127.0.0.1:<port> origin is ALSO allowed automatically — see
# src/core/config/cors-origin.util.ts. In production only the origin(s)
# listed here are ever allowed; there is no wildcard and no dev fallback.
FRONTEND_URL=http://localhost:5183

# Phase 15: password-reset email delivery. DEVELOPMENT (default) never makes
# a real network call — it keeps sent messages in memory so tests/dev can
# read the reset code back programmatically, and logs only that an email was
# "sent" (never the code itself). SMTP requires SMTP_HOST/USER/PASS/FROM
# below and sends real email via nodemailer — never commit real SMTP
# credentials.
# SMTP_SECURE is optional — it defaults to true only for port 465 (implicit
# TLS) and false for every other port (STARTTLS, e.g. 587). Set it explicitly
# only to override that default; env validation rejects the contradictory
# combinations SMTP_PORT=465/SMTP_SECURE=false and SMTP_PORT=587/SMTP_SECURE=true.
# SMTP_FROM is optional — if unset, it falls back to SMTP_USER (which must
# then itself be a valid email address). SMTP_FROM_NAME is required whenever
# EMAIL_PROVIDER=SMTP (it's the display name on the From header).
# Most relays only allow sending as the authenticated account, so SMTP_FROM
# must equal SMTP_USER unless SMTP_VERIFIED_SENDER=true, which asserts that
# SMTP_FROM has been separately verified as a sender identity with your
# provider (e.g. a domain/sender verified in a SendGrid/Mailgun/etc dashboard).
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_VERIFIED_SENDER=false
