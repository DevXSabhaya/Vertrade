# Render's build step runs `npm install` with NODE_ENV=production set (see
# .env.production / the Google OAuth migration notes for why NODE_ENV must
# be production there) — without this, npm treats NODE_ENV=production as an
# implicit `--omit=dev`, silently skipping every devDependency, including
# @nestjs/cli (the `nest` binary the build script invokes), typescript, and
# tsc-alias. That produced the exact build failure "sh: 1: nest: not found"
# after a fresh `npm install` on Render.
#
# The build step and the runtime step are the same `npm install` on Render
# (there is no separate prune-after-build stage for this service), so
# devDependencies must be installed for `npm run build` to work at all —
# this does not affect what actually runs at request time, since
# `npm run start:prod` only ever executes the compiled dist/main.js.
production=false
