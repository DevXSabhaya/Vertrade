# Frontend environment variables must be prefixed with VITE_ to be exposed to client code.

# The backend has no global route prefix — it's the bare origin.
VITE_API_BASE_URL=http://localhost:3000

# Reserved for a future real-time market-data layer (Phase 13 ships a clean
# abstraction only; no live socket connection is implemented yet).
# VITE_WS_URL=ws://localhost:3000
